[Unit]
Description=Mini-Cloud App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/mini-cloud
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# Optional if using nvm or custom PATH
# Environment=PATH=/usr/local/bin:/usr/bin

[Install]
WantedBy=multi-user.target
